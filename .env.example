# Server-only OpenAI configuration. Do not prefix these variables with NEXT_PUBLIC_.
# Create a key at https://platform.openai.com/api-keys and add it only to .env.local
# locally, or to Vercel Project Settings → Environment Variables in production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Leave blank to use the official OpenAI API.
# Set only for an OpenAI-compatible endpoint such as a self-hosted Ollama server.
OPENAI_BASE_URL=

# Supabase is required to protect AI access in production. Create a project at
# https://supabase.com, then add the Project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set true for any shared or deployed environment. Production defaults to true.
AI_REQUIRE_AUTH=false
